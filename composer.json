{
	"name": "medinaproduction/laravel-toolkit",
	"description": "MedinaProduction Laravel Toolkit Package",
	"type": "library",
	"keywords": ["laravel"],
	"license": "MIT",
	"authors": [
		{
			"name": "Edward Karlsson",
			"email": "edward@medinaproduction.se"
		}
	],
	"require": {
		"php": "^8.3",
		"laravel/framework": "^13.0"
	},
	"require-dev": {
		"fakerphp/faker": "^1.23",
		"mockery/mockery": "^1.6.10",
		"phpunit/phpunit": "^12.5.8",
		"orchestra/testbench": "^11.0"
	},
	"autoload": {
		"psr-4": {
			"MedinaProduction\\Toolkit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MedinaProduction\\Toolkit\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "vendor/bin/phpunit"
	},
	"extra": {
		"laravel": {
			"providers": [
				"MedinaProduction\\Toolkit\\ServiceProvider"
			]
		}
	}
}
